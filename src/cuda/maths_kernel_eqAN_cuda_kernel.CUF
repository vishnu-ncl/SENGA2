         (ydim3 .NE. ydim3_maths_kernel_eqAN_h) .OR. &
         (xdim4 .NE. xdim4_maths_kernel_eqAN_h) .OR. &
         (ydim4 .NE. ydim4_maths_kernel_eqAN_h) .OR. &
         (xdim5 .NE. xdim5_maths_kernel_eqAN_h) .OR. &
         (ydim5 .NE. ydim5_maths_kernel_eqAN_h) .OR. &
         (xdim6 .NE. xdim6_maths_kernel_eqAN_h) .OR. &
         (ydim6 .NE. ydim6_maths_kernel_eqAN_h) .OR. &
         (xdim7 .NE. xdim7_maths_kernel_eqAN_h) .OR. &
         (ydim7 .NE. ydim7_maths_kernel_eqAN_h) .OR. &
         (xdim8 .NE. xdim8_maths_kernel_eqAN_h) .OR. &
         (ydim8 .NE. ydim8_maths_kernel_eqAN_h) .OR. &
         (xdim9 .NE. xdim9_maths_kernel_eqAN_h) .OR. &
         (ydim9 .NE. ydim9_maths_kernel_eqAN_h) &
       ) THEN
            xdim1_maths_kernel_eqAN = xdim1
            xdim1_maths_kernel_eqAN_h = xdim1
            ydim1_maths_kernel_eqAN = ydim1
            ydim1_maths_kernel_eqAN_h = ydim1
            xdim2_maths_kernel_eqAN = xdim2
            xdim2_maths_kernel_eqAN_h = xdim2
            ydim2_maths_kernel_eqAN = ydim2
            ydim2_maths_kernel_eqAN_h = ydim2
            xdim3_maths_kernel_eqAN = xdim3
            xdim3_maths_kernel_eqAN_h = xdim3
            ydim3_maths_kernel_eqAN = ydim3
            ydim3_maths_kernel_eqAN_h = ydim3
            xdim4_maths_kernel_eqAN = xdim4
            xdim4_maths_kernel_eqAN_h = xdim4
            ydim4_maths_kernel_eqAN = ydim4
            ydim4_maths_kernel_eqAN_h = ydim4
            xdim5_maths_kernel_eqAN = xdim5
            xdim5_maths_kernel_eqAN_h = xdim5
            ydim5_maths_kernel_eqAN = ydim5
            ydim5_maths_kernel_eqAN_h = ydim5
            xdim6_maths_kernel_eqAN = xdim6
            xdim6_maths_kernel_eqAN_h = xdim6
            ydim6_maths_kernel_eqAN = ydim6
            ydim6_maths_kernel_eqAN_h = ydim6
            xdim7_maths_kernel_eqAN = xdim7
            xdim7_maths_kernel_eqAN_h = xdim7
            ydim7_maths_kernel_eqAN = ydim7
            ydim7_maths_kernel_eqAN_h = ydim7
            xdim8_maths_kernel_eqAN = xdim8
            xdim8_maths_kernel_eqAN_h = xdim8
            ydim8_maths_kernel_eqAN = ydim8
            ydim8_maths_kernel_eqAN_h = ydim8
            xdim9_maths_kernel_eqAN = xdim9
            xdim9_maths_kernel_eqAN_h = xdim9
            ydim9_maths_kernel_eqAN = ydim9
            ydim9_maths_kernel_eqAN_h = ydim9
    END IF

    grid = dim3( (x_size-1)/getOPS_block_size_x()+ 1, (y_size-1)/getOPS_block_size_y() + 1, z_size)
    tblock = dim3(getOPS_block_size_x(), getOPS_block_size_y(), 1)

!   ==============
!   Halo exchanges
!   ==============
#ifndef OPS_LAZY
    CALL ops_H_D_exchanges_device(opsArgArray, 9)
    CALL ops_halo_exchanges(opsArgArray, 9, range, 3)
#endif

    CALL ops_timers_core(t2__)

    CALL maths_kernel_eqAN_wrap <<<grid,tblock>>> (&
                                    opsDat1Local, &
                                    opsDat2Local, &
                                    opsDat3Local, &
                                    opsDat4Local, &
                                    opsDat5Local, &
                                    opsDat6Local, &
                                    opsDat7Local, &
                                    opsDat8Local, &
                                    opsDat9Local, &
                                    dat1_base, &
                                    dat2_base, &
                                    dat3_base, &
                                    dat4_base, &
                                    dat5_base, &
                                    dat6_base, &
                                    dat7_base, &
                                    dat8_base, &
                                    dat9_base, &
                                    x_size, y_size, z_size )

    istat = cudaDeviceSynchronize()
    call ops_timers_core(t3__)

#ifndef OPS_LAZY
    CALL ops_set_dirtybit_device(opsArgArray, 9)
    CALL ops_set_halo_dirtybit3(opsArg1, range, 3)
#endif

!   ========================
!   Timing and data movement
!   ========================
    transfer_total = 0.0_4
    CALL ops_compute_transfer(3, start_indx, end_indx, opsArg1, transfer)
    transfer_total = transfer_total + transfer
    CALL ops_compute_transfer(3, start_indx, end_indx, opsArg2, transfer)
    transfer_total = transfer_total + transfer
    CALL ops_compute_transfer(3, start_indx, end_indx, opsArg3, transfer)
    transfer_total = transfer_total + transfer
    CALL ops_compute_transfer(3, start_indx, end_indx, opsArg4, transfer)
    transfer_total = transfer_total + transfer
    CALL ops_compute_transfer(3, start_indx, end_indx, opsArg5, transfer)
    transfer_total = transfer_total + transfer
    CALL ops_compute_transfer(3, start_indx, end_indx, opsArg6, transfer)
    transfer_total = transfer_total + transfer
    CALL ops_compute_transfer(3, start_indx, end_indx, opsArg7, transfer)
    transfer_total = transfer_total + transfer
    CALL ops_compute_transfer(3, start_indx, end_indx, opsArg8, transfer)
    transfer_total = transfer_total + transfer
    CALL ops_compute_transfer(3, start_indx, end_indx, opsArg9, transfer)
    transfer_total = transfer_total + transfer

    CALL setKernelTime(271, kernelName//c_null_char, t3__-t2__, t2__-t1__, transfer_total, 0)

END SUBROUTINE

#ifdef OPS_LAZY
ATTRIBUTES (HOST) SUBROUTINE maths_kernel_eqAN_host( userSubroutine, block, dim, range, &
    opsArg1, &
    opsArg2, &
    opsArg3, &
    opsArg4, &
    opsArg5, &
    opsArg6, &
    opsArg7, &
    opsArg8, &
    opsArg9 &
    )

    CHARACTER(KIND=C_CHAR,LEN=*), INTENT(IN), TARGET :: userSubroutine
    TYPE(ops_block), INTENT(IN) :: block
    INTEGER(KIND=4), INTENT(IN) :: dim
    INTEGER(KIND=4), DIMENSION(2*dim), INTENT(INOUT), TARGET :: range
    INTEGER(KIND=4), DIMENSION(2*dim), TARGET :: range_tmp

    TYPE(ops_arg), INTENT(IN) :: opsArg1
    TYPE(ops_arg), INTENT(IN) :: opsArg2
    TYPE(ops_arg), INTENT(IN) :: opsArg3
    TYPE(ops_arg), INTENT(IN) :: opsArg4
    TYPE(ops_arg), INTENT(IN) :: opsArg5
    TYPE(ops_arg), INTENT(IN) :: opsArg6
    TYPE(ops_arg), INTENT(IN) :: opsArg7
    TYPE(ops_arg), INTENT(IN) :: opsArg8
    TYPE(ops_arg), INTENT(IN) :: opsArg9

    TYPE(ops_arg), DIMENSION(9), TARGET :: opsArgArray
    INTEGER(KIND=4) :: n_indx
    CHARACTER(LEN=40) :: namelit

    namelit = "maths_kernel_eqAN"

    opsArgArray(1) = opsArg1
    opsArgArray(2) = opsArg2
    opsArgArray(3) = opsArg3
    opsArgArray(4) = opsArg4
    opsArgArray(5) = opsArg5
    opsArgArray(6) = opsArg6
    opsArgArray(7) = opsArg7
    opsArgArray(8) = opsArg8
    opsArgArray(9) = opsArg9

    DO n_indx = 1, 3
        range_tmp(2*n_indx-1) = range(2*n_indx-1)-1
        range_tmp(2*n_indx)   = range(2*n_indx)
    END DO

    CALL create_kerneldesc_and_enque(namelit//c_null_char, c_loc(opsArgArray), &
                                    9, 271, dim, 1, c_loc(range_tmp), &
                                    block%blockCptr, c_funloc(maths_kernel_eqAN_host_execute))

END SUBROUTINE
#endif

END MODULE MATHS_KERNEL_EQAN_MODULE
