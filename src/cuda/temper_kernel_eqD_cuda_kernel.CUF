                tdpoly = tderiv(OPS_ACC_MD3(icp,0,0,0))   + tdpoly*tempor
            END DO

            tfpoly = tcoeff(OPS_ACC_MD2(1,0,0,0)) + tfpoly*tempor

!           RE-EVALUATE TEMPERATURE CORRECTION
